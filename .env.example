# Copy to .env and fill in, or export these directly in your shell.
# .env is gitignored; never commit real credentials.

# HubSpot Service Key (Development > Keys > Service Keys)
# Scopes: crm.objects.deals, crm.objects.contacts, crm.objects.companies,
#         crm.objects.owners.read, crm.schemas.deals.write
HUBSPOT_TOKEN=

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Slack bot token, needs chat:write and files:write, bot invited to the channel
SLACK_BOT_TOKEN=xoxb-
SLACK_CHANNEL_ID=C
